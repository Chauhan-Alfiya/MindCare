# ============================================================
# AI CONVERSATIONAL ASSESSMENT
# 100% DYNAMIC AI QUESTIONS
# ============================================================

@app.route("/ai_assessment")
def ai_assessment():

    # LOGIN CHECK
    if "user_id" not in session:
        return redirect(url_for("login"))

    # STUDENT ONLY
    if session.get("role") != "STUDENT":
        return redirect(url_for("dashboard_redirect"))

    # CLEAR OLD ASSESSMENT DATA
    session.pop("ai_assessment_history", None)
    session.pop("ai_assessment_answers", None)
    session.pop("ai_assessment_turns", None)

    # START EMPTY AI HISTORY
    session["ai_assessment_history"] = []
    session["ai_assessment_answers"] = []
    session["ai_assessment_turns"] = 0

    try:
        # AI GENERATES THE FIRST QUESTION
        response = client.chat.completions.create(

            model=os.getenv(
                "GROQ_MODEL",
                "llama-3.3-70b-versatile"
            ),

            messages=[
                {
                    "role": "system",
                    "content": """
You are MindCare AI Wellness Assessment Assistant for high-school students.

Start a friendly conversational wellness assessment.

Your job is to understand how the student has been feeling by asking
ONE question at a time.

IMPORTANT RULES:
- Ask only ONE simple question.
- Do not mention a fixed number of questions.
- Do not say this assessment has exactly 5 questions.
- Do not diagnose any mental health condition.
- Do not prescribe medicine.
- Use simple, friendly and supportive English.
- Do not give a final result yet.
- Start by asking about how the student has been feeling recently.

Return ONLY the question.
"""
                }
            ],

            temperature=0.7,
            max_completion_tokens=150
        )

        first_question = (
            response
            .choices[0]
            .message
            .content
            .strip()
        )

    except Exception as err:

        print(
            "First AI Question Error:",
            repr(err)
        )

        # AI ERROR FALLBACK
        first_question = (
            "Hello! 💙 How have you been feeling recently?"
        )


    # SAVE AI QUESTION IN HISTORY
    session["ai_assessment_history"] = [
        {
            "role": "assistant",
            "content": first_question
        }
    ]

    session.modified = True

    return render_template(
        "ai_assessment.html",
        history=session["ai_assessment_history"],
        completed=False
    )


# ============================================================
# AI ASSESSMENT - SEND ANSWER
# ============================================================

@app.route("/ai_assessment/send", methods=["POST"])
def ai_assessment_send():

    # LOGIN CHECK
    if "user_id" not in session:
        return jsonify({
            "error": "Please login first."
        }), 401


    # STUDENT ONLY
    if session.get("role") != "STUDENT":
        return jsonify({
            "error": "Access denied."
        }), 403


    # GET JSON DATA
    data = request.get_json(silent=True) or {}

    answer = str(
        data.get("message", "")
    ).strip()


    # EMPTY ANSWER CHECK
    if not answer:
        return jsonify({
            "error": "Please enter your answer."
        }), 400


    # GET CURRENT HISTORY
    history = session.get(
        "ai_assessment_history",
        []
    )

    answers = session.get(
        "ai_assessment_answers",
        []
    )

    turns = session.get(
        "ai_assessment_turns",
        0
    )


    # SAVE STUDENT ANSWER
    history.append({
        "role": "user",
        "content": answer
    })

    answers.append(answer)

    turns += 1


    # ========================================================
    # CREATE AI PROMPT WITH COMPLETE CONVERSATION
    # ========================================================

    conversation = ""

    for item in history:
        if item["role"] == "assistant":
            conversation += (
                "AI QUESTION: "
                + item["content"]
                + "\n"
            )
        else:
            conversation += (
                "STUDENT ANSWER: "
                + item["content"]
                + "\n"
            )


    # ========================================================
    # SAFETY MAXIMUM LIMIT
    # This is NOT a fixed assessment.
    # It only prevents endless AI questions.
    # ========================================================

    max_turns = 10


    # ========================================================
    # AI DECIDES:
    # ASK NEXT QUESTION OR COMPLETE ASSESSMENT
    # ========================================================

    prompt = f"""
You are MindCare AI Wellness Assessment Assistant for high-school students.

You are conducting a dynamic conversational wellness assessment.

Below is the COMPLETE conversation:

{conversation}

Your job is to analyse the COMPLETE conversation and decide what should happen next.

You have two possible actions:

ACTION 1: ASK
Ask ONE new and relevant follow-up question.

ACTION 2: COMPLETE
If you have enough information about the student's general emotional
wellbeing and daily functioning, complete the assessment.

IMPORTANT RULES:

- The assessment is dynamic.
- There is NO fixed list of questions.
- Do NOT repeat a question already asked.
- Carefully read all previous AI questions and student answers.
- Ask only ONE question at a time.
- The next question must depend on what the student has already said.
- Do NOT ask about sleep, anxiety, studies, mood, or any topic unless
  it is relevant to the conversation.
- Do NOT diagnose depression, anxiety, or any medical condition.
- Do NOT prescribe medicine.
- Use simple, supportive English suitable for high-school students.
- Do not scare the student.

If the student has mentioned immediate danger, self-harm, suicide,
or being unsafe, choose COMPLETE immediately and use
"Urgent Support".

You must return ONLY valid JSON.

Use EXACTLY one of these formats.

IF YOU NEED MORE INFORMATION:

{{
    "action": "ASK",
    "question": "Your one new question here"
}}

IF YOU HAVE ENOUGH INFORMATION:

{{
    "action": "COMPLETE",
    "risk_level": "Doing Well",
    "support_required": false,
    "recommendation": "A short supportive summary based on what the student shared.",
    "suggestions": [
        "First practical suggestion",
        "Second practical suggestion",
        "Third practical suggestion"
    ]
}}

Allowed risk levels ONLY:

- "Doing Well"
- "Support Recommended"
- "Urgent Support"

Rules for support_required:

- "Doing Well" = false
- "Support Recommended" = true
- "Urgent Support" = true

Return JSON only.
Do not use markdown.
Do not use ```json.
"""


    # ========================================================
    # FORCE COMPLETION AFTER SAFETY LIMIT
    # ========================================================

    if turns >= max_turns:

        prompt += """

IMPORTANT:
The conversation has reached the maximum allowed length.

You MUST now choose:

{
    "action": "COMPLETE",
    ...
}

Do not ask another question.
"""


    try:

        response = client.chat.completions.create(

            model=os.getenv(
                "GROQ_MODEL",
                "llama-3.3-70b-versatile"
            ),

            messages=[
                {
                    "role": "system",
                    "content": """
You are a safe and supportive AI wellness assessment assistant.

You must carefully analyse the complete conversation.

Never repeat an already asked question.

Return valid JSON only.
"""
                },
                {
                    "role": "user",
                    "content": prompt
                }
            ],

            temperature=0.4,
            max_completion_tokens=500
        )


        ai_response = (
            response
            .choices[0]
            .message
            .content
            .strip()
        )


        # CONVERT AI JSON RESPONSE
        ai_data = json.loads(ai_response)


    except Exception as err:

        print(
            "Dynamic AI Assessment Error:",
            repr(err)
        )

        return jsonify({
            "error": (
                "Unable to continue the AI assessment. "
                "Please try again."
            )
        }), 500


    # ========================================================
    # AI WANTS TO ASK NEXT QUESTION
    # ========================================================

    action = ai_data.get(
        "action",
        "ASK"
    )


    if action == "ASK" and turns < max_turns:

        next_question = str(
            ai_data.get(
                "question",
                ""
            )
        ).strip()


        # VALIDATE QUESTION
        if not next_question:

            next_question = (
                "Can you tell me a little more about "
                "how you have been feeling recently?"
            )


        # SAVE AI QUESTION
        history.append({
            "role": "assistant",
            "content": next_question
        })


        # UPDATE SESSION
        session["ai_assessment_history"] = history
        session["ai_assessment_answers"] = answers
        session["ai_assessment_turns"] = turns

        session.modified = True


        return jsonify({

            "completed": False,

            "reply": next_question

        })


    # ========================================================
    # AI COMPLETES ASSESSMENT
    # ========================================================

    risk_level = ai_data.get(
        "risk_level",
        "Support Recommended"
    )


    support_required = ai_data.get(
        "support_required",
        True
    )


    recommendation = str(
        ai_data.get(
            "recommendation",
            "Thank you for sharing how you have been feeling."
        )
    ).strip()


    suggestions = ai_data.get(
        "suggestions",
        []
    )


    # VALIDATE RISK LEVEL
    valid_risk_levels = [
        "Doing Well",
        "Support Recommended",
        "Urgent Support"
    ]


    if risk_level not in valid_risk_levels:

        risk_level = "Support Recommended"


    # SET SUPPORT REQUIRED CORRECTLY
    if risk_level == "Doing Well":

        support_required = False

    else:

        support_required = True


    # MAKE SURE SUGGESTIONS IS A LIST
    if not isinstance(suggestions, list):

        suggestions = []


    # ========================================================
    # DATABASE SCORE
    # ========================================================

    if risk_level == "Doing Well":

        score = 1

    elif risk_level == "Support Recommended":

        score = 2

    else:

        score = 3


    # ========================================================
    # SAVE RESULT IN DATABASE
    # ========================================================

    db = None
    cursor = None


    try:

        db = get_db_connection()

        cursor = db.cursor()


        cursor.execute(
            """
            INSERT INTO assessments
            (
                user_id,
                assessment_type,
                score,
                risk_level,
                recommendation
            )

            VALUES
            (
                %s,
                %s,
                %s,
                %s,
                %s
            )
            """,
            (
                session["user_id"],
                "AI Conversational Assessment",
                score,
                risk_level,
                recommendation
            )
        )


        db.commit()


    except Exception as err:

        if db:

            db.rollback()


        print(
            "AI Assessment Database Error:",
            repr(err)
        )


    finally:

        if cursor:

            cursor.close()


        if db:

            db.close()


    # ========================================================
    # CLEAR ASSESSMENT SESSION
    # ========================================================

    session.pop(
        "ai_assessment_history",
        None
    )

    session.pop(
        "ai_assessment_answers",
        None
    )

    session.pop(
        "ai_assessment_turns",
        None
    )


    session.modified = True


    # ========================================================
    # SEND FINAL RESULT
    # ========================================================

    return jsonify({

        "completed": True,

        "risk_level": risk_level,

        "support_required": support_required,

        "recommendation": recommendation,

        "suggestions": suggestions

    })